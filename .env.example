# MedNexus AI — real Claude integration (baked in at bundle time by Expo).
# Copy this file to `.env.local` (or `.env`) and fill in your own values.
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle, so these DO end up
# in the shipped client. Use a short-lived key and rotate it before/after the
# hackathon. If the token is omitted/empty, the app gracefully falls back to
# the local deterministic knowledge-network engine (no breakage).

# Required for real AI narratives:
EXPO_PUBLIC_ANTHROPIC_AUTH_TOKEN=

# Optional — defaults shown (proxy base from your env):
EXPO_PUBLIC_ANTHROPIC_BASE_URL=https://agentrouter.org
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-4-8
