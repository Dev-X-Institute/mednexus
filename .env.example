# MedNexus AI — Environment Configuration
# Copy this file to `.env.local` (or `.env`) and fill in your own values.
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle, so these DO end up
# in the shipped client. Use short-lived keys and rotate them regularly.
# If omitted/empty, the app gracefully falls back to local demo data.

# ─── Supabase (Backend) ───
# Required for live data mode (Dashboard, Analytics, Memory, etc.)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Anthropic Claude (AI Narratives) ───
# Required for real AI clinical narratives in Clinical Memory tab
EXPO_PUBLIC_ANTHROPIC_AUTH_TOKEN=

# Optional — defaults shown (proxy base from your env):
EXPO_PUBLIC_ANTHROPIC_BASE_URL=https://agentrouter.org
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-4-8
