                    </View>
                    <Text style={[styles.roleLabel, { color: c.text }]}>{role.label}</Text>
                    <Text style={[styles.roleDesc, { color: c.textSecondary }]}>{role.desc}</Text>
                    {selectedRole === role.id && (
