import { View, useColorScheme, type StyleProp, type ViewStyle } from "react-native";
import { Colors, Radii, Spacing } from "@/constants/theme";

type CardVariant = "default" | "elevated" | "glass";

interface CardProps {
  variant?: CardVariant;
  style?: StyleProp<ViewStyle>;
  children?: React.ReactNode;
}

export function Card({ variant = "default", style, children }: CardProps) {
  const scheme = useColorScheme();
  const colors = Colors[scheme === "dark" ? "dark" : "light"];

  const backgrounds: Record<CardVariant, string> = {
    default: colors.card,
    elevated: colors.cardElevated,
    glass: colors.glass,
  };

  return (
    <View
      style={[
        {
          backgroundColor: backgrounds[variant],
          borderColor: colors.border,
          borderWidth: 1,
          borderRadius: Radii.lg,
          padding: Spacing.three,
        },
        style,
      ]}
    >
      {children}
    </View>
  );
}
</file>

